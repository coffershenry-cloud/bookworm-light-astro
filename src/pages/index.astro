---
import Posts from "@/components/Posts.astro";
import Base from "@/layouts/Base.astro";
import { getSinglePage } from "@/lib/contentParser.astro";
import { sortByDate } from "@/lib/utils/sortFunctions";

const posts = await getSinglePage("posts");
const sortedPosts = sortByDate(posts);
const currentPosts = sortedPosts.slice(0, 100);
---

<Base>
  <section class="section pt-8 pb-5">
    <div class="inkglobe-wide">
      <h1 class="text-center text-2xl font-extrabold leading-tight text-dark md:text-3xl">
        Made for Small Businesses
      </h1>
    </div>
  </section>

  <section class="section pt-4">
    <div class="inkglobe-wide">
      <h2 class="mb-8 text-left text-xl font-bold md:text-2xl">
        Latest Small Business Guides
      </h2>
      <Posts posts={currentPosts} className="mb-16" />
    </div>
  </section>
</Base>

<style is:global>
  .inkglobe-wide {
    width: 100%;
    max-width: none;
    margin-left: auto;
    margin-right: auto;
    padding-left: clamp(16px, 2.5vw, 40px);
    padding-right: clamp(16px, 2.5vw, 40px);
  }
</style>