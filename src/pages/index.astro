

---
import Posts from "@/layouts/components/Posts.astro";
import config from "@/config/config.json";
import Base from "@/layouts/Base.astro";
import Pagination from "@/layouts/components/Pagination.astro";
import { getSinglePage } from "@/lib/contentParser.astro";
import { sortByDate } from "@/lib/utils/sortFunctions";

const posts = await getSinglePage("posts");
const sortedPosts = sortByDate(posts);
const totalPages = Math.ceil(posts.length / config.settings.pagination);
const currentPosts = sortedPosts.slice(0, config.settings.pagination);

const businessAreas = [
  {
    title: "Business Finance",
    description:
      "Guides to business funding, credit cards, loans, cash flow and financial decisions.",
    url: "/categories/finance",
  },
  {
    title: "Business Insurance",
    description:
      "Clear explanations of business insurance, coverage, costs and how to compare policies.",
    url: "/categories/insurance",
  },
  {
    title: "Business Software",
    description:
      "Practical comparisons and guides to software that helps small businesses work smarter.",
    url: "/categories/software",
  },
];
---

<Base
  title="InkGlobe | Business Finance, Insurance and Software for Small Businesses"
  meta_title="InkGlobe | Business Finance, Insurance and Software for Small Businesses"
  description="InkGlobe helps small businesses make informed decisions with practical guides and comparisons on business finance, insurance and software."
  canonical="https://inkglobe.com/"
>
  <section class="section pb-8">
    <div class="container">
      <div class="mx-auto max-w-4xl text-center">
        <p class="mb-3 text-sm font-semibold uppercase tracking-[0.18em] text-primary">
          InkGlobe
        </p>
        <h1 class="mb-5 text-4xl font-bold leading-tight text-dark md:text-5xl">
          Your Go-To Resource for Small Businesses
        </h1>
        <p class="mx-auto max-w-3xl text-lg leading-relaxed text-text">
          Make better business decisions with practical information, helpful
          guides and clear comparisons across business finance, insurance and
          software.
        </p>
      </div>
    </div>
  </section>

  <section class="section pt-4">
    <div class="container">
      <div class="mb-10 text-center">
        <h2 class="mb-3">Explore Small Business Resources</h2>
        <p class="text-text">
          Find guidance for the financial, insurance and technology decisions
          that keep a business moving.
        </p>
      </div>

      <div class="row gy-4">
        {businessAreas.map((area) => (
          <div class="col-12 md:col-4">
            <a
              href={area.url}
              class="group block h-full rounded-lg border border-border p-6 transition duration-300 hover:border-primary hover:shadow-md"
            >
              <h3 class="mb-3 transition group-hover:text-primary">
                {area.title}
              </h3>
              <p class="mb-4 text-text">{area.description}</p>
              <span class="font-semibold text-primary">Explore guides →</span>
            </a>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="mb-10">
        <h2 class="mb-3">Latest Small Business Guides</h2>
        <p class="text-text">
          Explore recent articles, practical explanations and comparisons from
          InkGlobe.
        </p>
      </div>
      <Posts posts={currentPosts} className="mb-16" />
      <Pagination currentPage={1} totalPages={totalPages} />
    </div>
  </section>
</Base>
